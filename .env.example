PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PYTHON_BIN=.venv\Scripts\python.exe
AKSHARE_TIMEOUT_MS=120000
AKSHARE_MAX_OUTPUT_BYTES=26214400
AKSHARE_EXPOSE_ERROR_DETAILS=false
FINANCE_DB_PATH=data\finance.sqlite
FINANCE_REFRESH_ENABLED=true
FINANCE_REFRESH_INTERVAL_DAYS=7
FINANCE_REFRESH_CHECK_MINUTES=60
FINANCE_PEER_CACHE_DAYS=7
FINANCE_SCREENER_CACHE_DAYS=7
ANNOUNCEMENT_REFRESH_ENABLED=true
ANNOUNCEMENT_REFRESH_HOURS=12
ANNOUNCEMENT_CHECK_MINUTES=15
ANNOUNCEMENT_BATCH_SIZE=2
ANNOUNCEMENT_REQUEST_GAP_MS=3000
ETF_MARKET_CACHE_MINUTES=3
ETF_HISTORY_CACHE_HOURS=24
REQUEST_ERROR_LOG_ENABLED=true
REQUEST_ERROR_LOG_DIR=data\logs
REQUEST_ERROR_LOG_RETENTION_DAYS=14
REQUEST_ERROR_LOG_CLEANUP_INTERVAL_HOURS=24
